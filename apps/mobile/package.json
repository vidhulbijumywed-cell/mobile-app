    "export:native": "expo export --platform ios --platform android --output-dir dist-native"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.0",
    "@expo/metro-runtime": "~6.1.2"
  }
}
