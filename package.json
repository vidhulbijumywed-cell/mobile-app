    "dev:mobile": "npm run start --workspace @fitpilot/mobile",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  },
  "workspaces": [
    "apps/mobile"
  ]
}
